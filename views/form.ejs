<h2>New Message</h2> <!-- when form submitted, should send POST req to specified URL by action attrib. Add a POST route for new in router.-->
<form method="POST" action="/new">
    <p>New Message: </p>
    <input type="text" name="messageText"/>
    <p>From:</p>
    <input type="text" name="authorName"/>
    <button type="submit">Submit</button>
</form>