<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <h1><%= title %></h1>
        <%- include('navbar', {links: links}) %>
        <ul>
            <% for(let i = 0; i < messages.length; i++) { %>
            <li>
                <span><%= messages[i].text %></span>
                <p>From: <%= messages[i].user %>, <%= messages[i].added %></p>
            </li>
        <% } %>
        </ul>
    </body>
</html>