<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <ul>
        <% for(let i = 0; i < messages.length; i++) { %>
            <li>
                <div>
                    <span><%= messages.text %></span>
                    <p><%= messages.user %>, <%= messages.added %></p>
                </div>
            </li>
        <% } %>
        </ul>
    </body>
</html>