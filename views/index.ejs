<html>
    <head>
        <link rel="stylesheet" href="/styles.css"> 
        <title><%= title %></title>
    </head>
    <body>
        <h1><%= title %></h1>
        <%- include('navbar', {links: links}) %>
        <ul id="messageList">
            <% for(let i = 0; i < messages.length; i++) { %>
            <li>
                <div class="message">
                    <span><%= messages[i].text %></span>
                    <p style="font-weight: bold">From: <%= messages[i].user %></p>
                    <p class="dateText"><%= messages[i].added %></p>
                    <button id=<%-i %> name="showDetailsBtn">Show Details</button>
                </div>
            </li>
        <% } %>
        </ul>
    </body>
</html>